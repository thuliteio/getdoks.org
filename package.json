{
  "name": "doks-website",
  "version": "0.8.0",
  "description": "Doks website",
  "author": "Thulite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thuliteio/getdoks.org.git"
  },
  "scripts": {
    "clean:build": "npx shx rm -rf public resources hugo_stats.json .hugo_build.lock",
    "clean:install": "npx shx rm -rf node_modules package-lock.json",
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache",
    "format": "prettier **/** -w -c",
    "build": "hugo --minify --gc",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@docsearch/css": "^5.0.1",
    "@docsearch/js": "^5.0.1",
    "@tabler/icons": "^3.46.0",
    "@thulite/doks-core": "^1.9.3",
    "@thulite/images": "^3.3.4",
    "@thulite/inline-svg": "^1.2.2",
    "@thulite/seo": "^2.4.3",
    "thulite": "^2.6.5"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "glob": "^13.0.6",
    "undici": "^8.10.0",
    "@ai-sdk/provider-utils": "^5.0.27"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
